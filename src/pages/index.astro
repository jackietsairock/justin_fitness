---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  blogPosts,
  contactInfo,
  galleryImages,
  googleReviews,
  heroContent,
  latestNews,
  programHighlights,
  siteMeta,
  socialLinks,
  structuredData,
} from "../data/siteContent.js";
import SiteHeader from "../components/SiteHeader.jsx";
import Banner from "../components/Banner.jsx";
import ProgramHighlights from "../components/ProgramHighlights.jsx";
import LatestNews from "../components/LatestNews.jsx";
import Gallery from "../components/Gallery.jsx";
import BlogPosts from "../components/BlogPosts.jsx";
import Reviews from "../components/Reviews.jsx";
import ContactSection from "../components/ContactSection.jsx";
import SiteFooter from "../components/SiteFooter.jsx";
---

<BaseLayout
  title={siteMeta.title}
  description={siteMeta.description}
  canonical={siteMeta.canonical}
  siteName={siteMeta.siteName}
  keywords={siteMeta.keywords}
  ogImage={siteMeta.ogImage}
  ogImageAlt={siteMeta.ogImageAlt}
  locale={siteMeta.locale}
  structuredData={structuredData}
>
  <SiteHeader client:load />
  <main id="main-content">
    <Banner client:load content={heroContent} />

    <section class="bg-midnight py-20" aria-labelledby="about-heading">
      <div class="mx-auto flex max-w-5xl flex-col gap-10 px-6 sm:px-10 lg:flex-row lg:items-start">
        <div class="lg:w-2/5">
          <h2 id="about-heading" class="font-display text-3xl text-white sm:text-4xl">
            台北大同區一對一私人教練，陪你建立長期訓練習慣
          </h2>
          <p class="mt-5 text-sm leading-relaxed text-gray-300">
            Justin 擁有 AFAA 國際證照，在重量訓練、矯正運動與運動營養上具備扎實背景，
            於台北市大同區提供一對一私人教練、體態雕塑、增肌減脂與營養規劃服務，
            透過科學化訓練與生活管理，與你建立長期合作關係。
          </p>
        </div>
        <div class="grid gap-6 lg:w-3/5">
          <article class="rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur">
            <h3 class="text-lg font-semibold text-white">客製化訓練藍圖</h3>
            <p class="mt-3 text-sm leading-relaxed text-gray-300">
              從動作功能評估、肌力測試到生活型態分析，打造專屬於你的週期化訓練計畫。
            </p>
          </article>
          <article class="rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur">
            <h3 class="text-lg font-semibold text-white">數據追蹤與回饋</h3>
            <p class="mt-3 text-sm leading-relaxed text-gray-300">
              每週更新訓練數據與影片回顧，並提供調整建議，確保每一步都朝著目標前進。
            </p>
          </article>
          <article class="rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur">
            <h3 class="text-lg font-semibold text-white">生活整合策略</h3>
            <p class="mt-3 text-sm leading-relaxed text-gray-300">
              協助你在忙碌行程中維持營養攝取、睡眠與壓力管理，以穩定累積訓練成果。
            </p>
          </article>
        </div>
      </div>
    </section>

    <ProgramHighlights client:visible items={programHighlights} />
    <LatestNews client:visible items={latestNews} />
    <Gallery client:visible images={galleryImages} />
    <BlogPosts client:visible posts={blogPosts} />
    <Reviews client:visible reviews={googleReviews} />
    <ContactSection client:load contact={contactInfo} socials={socialLinks} />
  </main>
  <SiteFooter client:visible />
</BaseLayout>
